@page "/settings"
@namespace UnPocoMas.UI.Pages

<div class="upm-stack">
    <header>
        <p class="upm-brand"><span class="upm-brand-mark" aria-hidden="true">✦</span> Un Poco Más</p>
        <p class="upm-eyebrow upm-eyebrow--spaced">Preferencias</p>
        <h1 class="upm-title">Ajustes</h1>
        <p class="upm-subtitle">Personaliza tu partida cuando estas opciones estén disponibles.</p>
    </header>

    <section class="upm-card upm-card--padded upm-stack" aria-label="Ajustes provisionales">
        <div class="upm-switch-row">
            <label for="sound-setting">Sonido <small>Disponible próximamente</small></label>
            <input id="sound-setting" type="checkbox" disabled aria-label="Sonido, disponible próximamente" />
        </div>
        <div class="upm-switch-row">
            <label for="vibration-setting">Vibración <small>Disponible próximamente</small></label>
            <input id="vibration-setting" type="checkbox" disabled aria-label="Vibración, disponible próximamente" />
        </div>
        <div class="upm-switch-row">
            <label for="motion-setting">Reducir movimiento <small>Disponible próximamente</small></label>
            <input id="motion-setting" type="checkbox" disabled aria-label="Reducir movimiento, disponible próximamente" />
        </div>
    </section>
</div>
